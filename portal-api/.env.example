# Ambiente local/staging do Portal Cuidado Conectado.
# Nunca coloque credenciais reais neste arquivo ou no Git.
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fala_comigo_staging
NODE_ENV=staging
# Segredo JWT de staging; use pelo menos 32 caracteres e nunca o versionado abaixo.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Ajustes opcionais do pool PostgreSQL.
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
# Use require somente quando o servidor PostgreSQL/staging exigir TLS.
# PGSSLMODE=require

# Origem permitida do frontend local.
PORTAL_WEB_ORIGIN=http://127.0.0.1:4173
